# ─────────────────────────────────────────────────────────────────────────────
# JABOATÃO PREV - CONFIGURAÇÕES DO FRONTEND (.env)
# ─────────────────────────────────────────────────────────────────────────────
# Instruções:
# 1. Duplique este arquivo e renomeie a cópia para `.env`
# 2. Preencha os valores de acordo com o seu ambiente local ou produção
# 3. Nunca envie o arquivo `.env` final para o repositório Git
# ─────────────────────────────────────────────────────────────────────────────

# URL base da API do Backend (HTTP)
VITE_API_URL=http://localhost:3001

# URL do WebSocket da API do Backend (para atualizações em tempo real)
VITE_WS_URL=ws://localhost:3001

# ─────────────────────────────────────────────────────────────────────────────
# CONFIGURAÇÕES DO SUPABASE
# ─────────────────────────────────────────────────────────────────────────────
# URL pública do projeto Supabase
VITE_SUPABASE_URL=your_supabase_project_url

# Chave anônima pública do Supabase (Anon Key / Public Key)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
